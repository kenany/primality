{
  "name": "primality",
  "version": "3.0.0",
  "description": "A JavaScript library for prime numbers.",
  "keywords": [
    "browser",
    "client",
    "math",
    "mathematics",
    "number",
    "numbers",
    "util"
  ],
  "homepage": "https://github.com/kenany/primality",
  "bugs": {
    "url": "https://github.com/kenany/primality/issues"
  },
  "license": "MIT",
  "author": "Kenan Yildirim <kenan@kenany.me> (https://kenany.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenany/primality.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "types": "dist/index.d.cts",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.cjs": {
      "default": "./dist/*.cjs"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "scripts": {
    "build": "tsdown && tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "publint": "publint --strict",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "factorial": "^2.0.0",
    "lodash.isfinite": "^3.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@containerbase/semantic-release-pnpm": "1.4.2",
    "@kenan/biome-config": "1.0.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "publint": "0.3.23",
    "semantic-release": "25.0.8",
    "tsdown": "0.22.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
